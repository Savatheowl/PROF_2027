# Режим
PROF2027_ENV=prod

# Корень проекта (если пакет установлен не из папки PROF_2027)
# PROF2027_ROOT=C:\Users\sava\Desktop\ms\PROF_2027

# База данных
PROF2027_DB_PATH=data/prof2027.db

# Пользователи дашборда (логин / пароль)
PROF2027_ADMIN_USER=admin
PROF2027_ADMIN_PASSWORD=admin
PROF2027_ANALYST_USER=analyst
PROF2027_ANALYST_PASSWORD=analyst
PROF2027_VIEWER_USER=viewer
PROF2027_VIEWER_PASSWORD=viewer

# Telegram (пока пусто; бот запускается только при заполненном токене)
PROF2027_TELEGRAM_TOKEN=
PROF2027_TELEGRAM_ADMIN_IDS=

# REST API
PROF2027_API_KEY=

# Офлайн-режим моделей HuggingFace
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
