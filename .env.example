# PROF_2027 — пример переменных окружения.
# Скопируйте в .env и заполните нужные поля.

PROF2027_ENV=prod

# Путь к БД (от корня проекта)
PROF2027_DB_PATH=data/prof2027.db

# Доступы дашборда (по умолчанию печатаются при старте)
PROF2027_ADMIN_USER=admin
PROF2027_ADMIN_PASSWORD=admin
PROF2027_ANALYST_USER=analyst
PROF2027_ANALYST_PASSWORD=analyst
PROF2027_VIEWER_USER=viewer
PROF2027_VIEWER_PASSWORD=viewer

# Telegram (пока пусто — бот не запускается)
PROF2027_TELEGRAM_TOKEN=
PROF2027_TELEGRAM_ADMIN_IDS=

# REST API
PROF2027_API_KEY=

# Офлайн-режим Hugging Face
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
